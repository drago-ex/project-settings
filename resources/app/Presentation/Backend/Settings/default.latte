{templateType App\Presentation\Backend\Settings\SettingsTemplate}
{block title}{_'Website settings'}{/block}
{block content}
	{embed ../Accessory/Widget/@content.latte}
		{block content}
			<header class="mb-4 pb-2 border-bottom">
				<h1 n:block="title" class="h5 mb-1">{_'Website settings'}</h1>
				<p class="small text-body-secondary mb-0">{_'Set the basic information about the website.'}</p>
			</header>
			{embed '../../Accessory/Widget/@form.latte', name: 'settings'}
				{block form}
					{foreach $settingControls as $name}
						{include input, name: $name, columns: 6}
					{/foreach}
					<div class="d-block">
						{include submit, name: 'save'}
					</div>
				{/block}
			{/embed}
		{/block}
	{/embed}
{/block}
