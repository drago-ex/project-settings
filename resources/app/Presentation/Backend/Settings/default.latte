{templateType App\Presentation\Backend\Settings\SettingsTemplate}
{block title}{_'Website settings'}{/block}
{block content}
	{embed ../Accessory/Widget/@content.latte}
		{block content}
			<header class="mb-4 pb-2 border-bottom">
				<h1 n:block="title" class="h5 mb-1">{_'Website settings'}</h1>
				<p class="small text-body-secondary mb-0">{_'Set the basic information about the website.'}</p>
			</header>

			{* one setting in a row, its name on the left and its field on the right (under each other on a phone);
			   the rows keep a readable width on a wide screen and the button stands at their right end *}
			<div class="row">
				<div class="col-xl-8">
					{embed '../../Accessory/Widget/@form.latte', name: 'settings', defaultClass: false}
						{block form}
							<div n:foreach="$settingControls as $name" class="row mb-3">
								{label $name, class => 'col-sm-4 col-form-label fw-semibold' /}
								<div class="col-sm-8 form-error">
									{input $name, class => 'form-control'}
								</div>
							</div>
							<div class="d-flex justify-content-end">
								{include submit, name: 'save'}
							</div>
						{/block}
					{/embed}
				</div>
			</div>
		{/block}
	{/embed}
{/block}
