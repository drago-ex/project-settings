{
	"name": "drago-ex/project-settings",
	"description": "Individual settings for the application.",
	"type": "drago-tools-resource",
	"license": "MIT",
	"require": {
		"php": ">=8.3 <9",
		"nette/application": "^3.0",
		"nette/di": "^3.0",
		"tracy/tracy": "^2.0",
		"drago-ex/database": "^3.0 || ^4.0",
		"drago-ex/application": "^3.0 || ^4.0",
		"drago-ex/project-backend": "^2.0",
		"drago-ex/form": "^2.0 || ^3.0"
	},
	"suggest": {
		"drago-ex/permission": "Enables generation of the settings permission provider."
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^2.0"
	},
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"resources/app": "app"
				}
			}
		},
		"drago-permission": "permission.php",
		"drago-translator": {
			"translation": "app/Presentation/Backend/Settings/Translate"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s -C",
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		]
	}
}
