{
	"name": "drago-ex/project-settings",
	"description": "Individual settings for the application.",
	"type": "drago-tools-resource",
	"license": ["MIT"],
	"require": {
		"php": ">=8.3 <9",
		"nette/application": "^3.0",
		"nette/di": "^3.0",
		"tracy/tracy": "^2.0",
		"drago-ex/database": "^3.0",
		"drago-ex/application": "^3.0",
		"drago-ex/project-backend": "^2.0",
		"drago-ex/form": "^2.0"
	},
	"suggest": {
		"drago-ex/permission": "Enables generation of the settings permission provider."
	},
	"require-dev": {
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^1.0"
	},
	"bin": ["bin/create-settings-permission"],
	"scripts": {
		"phpstan": "phpstan analyse",
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		]
	},
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"resources/app": "app"
				}
			},
			"commands": {
				"create:settings-permission": "php vendor/bin/create-settings-permission",
				"db:migrate-settings": "php vendor/bin/migration db:migrate vendor/drago-ex/project-settings/migrations"
			}
		},
		"drago-translator": {
			"translation": "app/Presentation/Backend/Settings/Translate"
		}
	}
}
