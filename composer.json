{
	"name": "drago-ex/project-settings",
	"type": "drago-tools-resource",
	"description": "Individual settings for the application.",
	"license": ["MIT"],
	"require": {
		"php": ">=8.3 <9",
		"nette/application": "^3.0",
		"nette/di": "^3.0",
		"tracy/tracy": "^2.0",
		"drago-ex/database": "^3.0",
		"drago-ex/application": "^2.0",
		"drago-ex/project-backend": "^2.0",
		"drago-ex/form": "^2.0"
	},
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"resources/app": "app"
				}
			},
			"commands": {
				"create:settings-permission": "php vendor/bin/create-settings-permission"
			}
		}
	},
	"require-dev": {
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^1.0"
	},
	"bin": [
		"bin/create-settings-permission"
	],
	"scripts": {
		"phpstan": "phpstan analyse",
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		]
	}
}
